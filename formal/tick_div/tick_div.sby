[options]
mode prove
depth 40

[engines]
# --nopresat: yosys-smtbmc --presat falsely reports assumptions unsat at step 0
# with $past-based assumptions (Yosys 0.70); assertion checking is unaffected.
smtbmc --nopresat z3

[script]
read_verilog -sv tick_div.sv tick_div_formal_top.sv
prep -top tick_div_formal_top

